<?php
namespace dbx\{modul};
 
class {modul} {

  private function test() {
    return "test1 call";
  }

  public function run() {
     $uid   =dbx()->user();
     $mid   =dbx()->sys('dbx_modul_id');
     $modul =dbx()->sys('dbx_modul');

     $action=dbx()->mod('dbx_action');

     switch ($action) {
       case 'test1':
           $content=$this->test();
           break;

       case 'test2':
           $obj=dbx()->inc('{modul}_test');
           $content=$obj->run('test');
           break;

       default:
         $oTPL=dbx()->get_SysObj('dbxTPL');
         $msg['msg']="Modul=($modul) Action=($action) is undef.";
         $content=$oTPL->get_tpl('dbx','alert-warning',$msg);

     } // sqitch()
     
     return $content;
   } 
   
   
} // class

?>