<?php
namespace dbx\{modul};

class {modul}_test {

  private function test() { 
    return "test inc call";
  }

  public function run($action='') {
     $uid   =dbx()->user();
     $mid   =dbx()->sys('dbx_modul_id');
     $modul =dbx()->sys('dbx_modul');

     $content="";

     switch ($action) {
       case 'test':
           $content=$this->test();
           break;

       default:
         $content="<div class='alert alert-warning' role='alert'>Modul=($modul) Inc=({modul}_test) Action=($action) is undef.</div>";
     } // switch
     return $content;
  } // run()

} // class

?>