PROJECT_NAME           = "dbxapp"
PROJECT_NUMBER         = "4.1.0"
PROJECT_BRIEF          = "CMS, Shop, Workflows und modulare Geschäftsanwendungen"
PROJECT_LOGO           = dbXapp-Logo.jpeg
OUTPUT_DIRECTORY       = C:/xampp/htdocs/dbxapp-docs/reference
HTML_OUTPUT            = current
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 340
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = docs/doxygen-awesome/header.html
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome/doxygen-awesome.css \
                         docs/doxygen-awesome/doxygen-awesome-sidebar-only.css \
                         docs/doxygen-awesome/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                         docs/doxygen-awesome/dbxapp-doxygen.css
HTML_EXTRA_FILES       = docs/doxygen-awesome/doxygen-awesome-darkmode-toggle.js \
                         docs/doxygen-awesome/doxygen-awesome-fragment-copy-button.js \
                         docs/doxygen-awesome/doxygen-awesome-paragraph-link.js \
                         docs/doxygen-awesome/doxygen-awesome-interactive-toc.js
HTML_COPY_CLIPBOARD    = NO
PAGE_OUTLINE_PANEL     = NO

INPUT_ENCODING         = UTF-8
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = .
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE =
IMAGE_PATH             = docs/assets
EXAMPLE_PATH           = .

INPUT                  = docs/doxygen-generated-main.dox \
                         index.php \
                         dbx/include \
                         dbx/modules \
                         dbx/js

RECURSIVE              = YES
FILE_PATTERNS          = *.php \
                         *.js \
                         *.dox

FILTER_PATTERNS        = *dbxApi.php="php -n docs/tools/doxygen_php_utf8_filter.php" \
                         *dbxUpload.class.php="php -n docs/tools/doxygen_php_utf8_filter.php"
FILTER_SOURCE_FILES    = YES

EXCLUDE                = dbx/vendor \
                         dbx/add_ons \
                         files/cache \
                         files/tmp \
                         files/temp \
                         .git \
                         .playwright-cli

EXCLUDE_PATTERNS       = */node_modules/* \
                         */vendor/* \
                         */cache/* \
                         */tmp/* \
                         */temp/* \
                         *.min.js \
                         *.map

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO

JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
